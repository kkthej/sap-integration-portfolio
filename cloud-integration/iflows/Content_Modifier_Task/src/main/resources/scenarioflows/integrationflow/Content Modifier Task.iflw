        <bpmn2:callActivity id="CallActivity_9" name="Final Responce">
            <bpmn2:extensionElements>
                <ifl:property>
                    <key>bodyType</key>
                    <value>expression</value>
                </ifl:property>
                <ifl:property>
                    <key>propertyTable</key>
                    <value/>
                </ifl:property>
                <ifl:property>
                    <key>headerTable</key>
                    <value/>
                </ifl:property>
                <ifl:property>
                    <key>wrapContent</key>
                    <value>&lt;EmployeeAcknowledgement&gt;
    &lt;TechnicalInformation&gt;
        &lt;MessageId&gt;${property.P_MessageId}&lt;/MessageId&gt;
        &lt;ExchangeId&gt;${property.P_ExchangeId}&lt;/ExchangeId&gt;
        &lt;CorrelationId&gt;${property.P_CorrelationID}&lt;/CorrelationId&gt;
        &lt;InterfaceName&gt;${property.P_InterfaceName}&lt;/InterfaceName&gt;
        &lt;Environment&gt;${property.P_Environment}&lt;/Environment&gt;
        &lt;ProcessingDate&gt;${property.P_ProcessingDate}&lt;/ProcessingDate&gt;
        &lt;ProcessingTime&gt;${property.P_ProcessingTime}&lt;/ProcessingTime&gt;
    &lt;/TechnicalInformation&gt;

    &lt;SourceInformation&gt;
        &lt;RequestId&gt;${header.H_RequestId}&lt;/RequestId&gt;
        &lt;SourceSystem&gt;${header.H_SourceSystem}&lt;/SourceSystem&gt;
        &lt;TargetSystem&gt;${property.P_TargetSystem}&lt;/TargetSystem&gt;
    &lt;/SourceInformation&gt;

    &lt;EmployeeInformation&gt;
        &lt;EmployeeId&gt;${property.P_EmployeeId}&lt;/EmployeeId&gt;
        &lt;CompleteName&gt;${property.P_CompleteName}&lt;/CompleteName&gt;
        &lt;Department&gt;${property.P_Department}&lt;/Department&gt;
        &lt;Country&gt;${property.P_Country}&lt;/Country&gt;
        &lt;EmploymentStatus&gt;${property.P_EmploymentStatus}&lt;/EmploymentStatus&gt;
    &lt;/EmployeeInformation&gt;

    &lt;SalaryInformation&gt;
        &lt;BasicSalary&gt;${property.P_BasicSalary}&lt;/BasicSalary&gt;
        &lt;Currency&gt;${property.P_Currency}&lt;/Currency&gt;
    &lt;/SalaryInformation&gt;

    &lt;ProcessingResult&gt;
        &lt;Status&gt;${property.P_ProcessingStatus}&lt;/Status&gt;
        &lt;Description&gt;
            Employee EMP-1001 from WORKDAY was accepted for SAP_S4HANA processing
        &lt;/Description&gt;
    &lt;/ProcessingResult&gt;
&lt;/EmployeeAcknowledgement&gt;</value>
                </ifl:property>
                <ifl:property>
