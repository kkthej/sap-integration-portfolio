${property.P_OrderDate}
${property.P_Currency}
${property.P_CustomerId}
${property.P_CustomerName}
${property.P_CustomerDisplay}
${property.P_CountryCode}
${property.P_ItemCount}
${property.P_TotalQuantity}
${property.P_OrderTotal}

${property.P_FirstMaterial}
${property.P_LastMaterial}</value>
